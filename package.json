    "qa:preflight": "node scripts/qa-preflight.mjs",
    "qa:stills": "node scripts/qa-preflight.mjs --with-stills",
    "verify": "npm run qa:preflight",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {

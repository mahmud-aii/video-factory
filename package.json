{
  "name": "video-factory",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "100% Cloud-Operated Multi-Brand Video Factory powered by Remotion v4, Faster-Whisper, and GitHub Actions Matrix rendering",
  "scripts": {
